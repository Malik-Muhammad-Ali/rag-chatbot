    {
      "parameters": {
        "jsCode": "const text = $input.first().json.markdown || \"\";\n\n// Remove skip links\nlet cleaned = text.replace(/\\[Skip to content.*?\\]\\(.*?\\)/gi, \"\");\n\n// Remove phone numbers\n// cleaned = cleaned.replace(/(\\+?\\d[\\d\\s\\-().]{7,})/g, \"\");\n\n// Remove address blocks\n// cleaned = cleaned.replace(/\\d+.*?(Street|St\\.|Road|Rd\\.|Avenue|Ave\\.|Canada|ON|CA)/gi, \"\");\n\n// Remove CTA phrases\n// const ctas = [\n//   \"Book An Appointment\",\n//   \"Call Us\",\n//   \"Contact Us\",\n//   \"Get Started\",\n//   \"Request Appointment\"\n// ];\n\n// ctas.forEach(cta => {\n//   const regex = new RegExp(cta, \"gi\");\n//   cleaned = cleaned.replace(regex, \"\");\n// });\n\n// Remove nav-style bullet lists\ncleaned = cleaned.replace(/^\\s*[-*].*$/gm, \"\");\n\n// Collapse whitespace\ncleaned = cleaned.replace(/\\n{3,}/g, \"\\n\\n\").trim();\n\nreturn {\n  cleaned_text: cleaned,\n  metadata: $input.first().json.metadata,\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2048,
        0
      ],
      "id": "125e3bd3-f0a9-4278-a0ae-6af8955eea16",
      "name": "Clean Pipeline 1"
    },
    {
      "parameters": {
        "jsCode": "let text = $input.first().json.cleaned_text || \"\";\n\n// 1. Remove images (markdown + base64 placeholders)\ntext = text.replace(/!\\[.*?\\]\\(.*?\\)/g, \"\");\ntext = text.replace(/<Base64-Image-Removed>/g, \"\");\n\n// 2. Remove empty or broken links\ntext = text.replace(/\\[\\s*\\]\\(.*?\\)/g, \"\");\ntext = text.replace(/\\[\\s*\\]/g, \"\");\n\n// 3. Remove tel:, mailto:, map links\n// text = text.replace(/\\(tel:.*?\\)/gi, \"\");\n// text = text.replace(/\\(mailto:.*?\\)/gi, \"\");\ntext = text.replace(/\\(https:\\/\\/maps\\.app\\.goo\\.gl\\/.*?\\)/gi, \"\");\n\n// 4. Remove social media links\n// text = text.replace(/\\[Facebook.*?\\)|\\[Twitter.*?\\)|\\[Instagram.*?\\)|\\[YouTube.*?\\)/gi, \"\");\n\n// 5. Remove CTA phrases\n// const ctas = [\n//   \"Book an Appointment\",\n//   \"Book Now\",\n//   \"Call Us\",\n//   \"Please call us\",\n//   \"book online\",\n//   \"Complimentary Phone Consult\"\n// ];\n\n// ctas.forEach(cta => {\n//   text = text.replace(new RegExp(cta, \"gi\"), \"\");\n// });\n\n// 6. Remove footer sections\n// text = text.replace(/©.*$/gims, \"\");\n// text = text.replace(/All rights reserved.*$/gims, \"\");\n// text = text.replace(/Location\\s+Ace Physio.*$/gims, \"\");\n\n// 7. Remove long directory-style lists\n// text = text.replace(/## Areas We Serve[\\s\\S]*?##/gi, \"## \");\n// text = text.replace(/## Insurance Partners[\\s\\S]*?##/gi, \"## \");\n\n// 8. Normalize whitespace\ntext = text.replace(/\\n{3,}/g, \"\\n\\n\").trim();\n\nreturn {\n  cleaned_text: text,\n  metadata: $input.first().json.metadata,\n};\n"
      },
