    {
      "parameters": {
        "jsCode": "// chunk size in words\nconst CHUNK_WORDS = 1500;\n\n// function to split text into chunks\nfunction chunkText(text, size) {\n  const words = text.split(/\\s+/);\n  const chunks = [];\n  for (let i = 0; i < words.length; i += size) {\n    chunks.push(words.slice(i, i + size).join(\" \"));\n  }\n  return chunks;\n}\n\nconst items = [];\n\nfor (const page of $input.all()) {\n  const url = $input.first().json.metadata.url;\n  const title = $input.first().json.metadata.title || \"\";\n  const content = $input.first().json.cleaned_text || \"\";\n\n  // create chunks\n  const chunks = chunkText(content, CHUNK_WORDS);\n\n  // output each chunk as separate item\n  for (const chunk of chunks) {\n    items.push({\n      json: {\n        client_id: $('Start Execution').first().json.client_id,\n        source_type: \"website\",\n        page_url: url,\n        page_name: title,\n        context_text: chunk\n      }\n    });\n  }\n}\n\nreturn items;\n"
      },
